{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "runtime": "edge"
    }
  },
  "routes": [
    { "src": "/debug", "dest": "/api/edge.js" },
    { "src": "/health", "dest": "/api/edge.js" },
    { "src": "/epg/(.*)", "dest": "/api/edge.js" },
    { "src": "/xmltv.php", "dest": "/api/edge.js" },
    { "src": "/(.*)", "dest": "/api/edge.js" }
  ],
  "env": {
    "MYEPG_URL": "https://myepg.top/dl/ZYxXtj2qH/"
  }
}
